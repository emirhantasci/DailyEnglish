# ── Frontend (Vite) ─────────────────────────────────────────
# In production the frontend proxies /api/ through nginx — no change needed.
VITE_API_URL=/api

# ── Backend / Docker Compose ─────────────────────────────────
# JWT secret — generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# The public URL of your frontend (used for CORS)
CORS_ORIGIN=https://yourdomain.com

# Port to expose the web container on the host
WEB_PORT=3000
