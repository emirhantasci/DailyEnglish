# ── JWT Secret (generate with: openssl rand -base64 48) ──
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# ── CORS: Frontend URL (use http://VPS_IP:3000 or your domain) ──
CORS_ORIGIN=http://localhost:3000

# ── Web port on host ──────────────────────────────────────────
WEB_PORT=3000
