# Stage 1: Build
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy csproj and restore dependencies
COPY api/LinguaFlame.Api.csproj api/
RUN dotnet restore "api/LinguaFlame.Api.csproj"

# Copy everything else and build
COPY api/. ./api/
WORKDIR "/src/api"
RUN dotnet build "LinguaFlame.Api.csproj" -c Release -o /app/build

# Stage 2: Publish
FROM build AS publish
RUN dotnet publish "LinguaFlame.Api.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Stage 3: Final
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=publish /app/publish .
EXPOSE 8080
ENTRYPOINT ["dotnet", "LinguaFlame.Api.dll"]
